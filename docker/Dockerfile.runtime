# Published GHCR image. The publish workflow places the release binary
# `mcp-gateway` beside this file and builds once per arch (x86_64 and
# aarch64 musl). Heroku and DigitalOcean still build docker/Dockerfile.
FROM gcr.io/distroless/static-debian12:nonroot
COPY mcp-gateway /usr/local/bin/mcp-gateway
USER nonroot
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/mcp-gateway"]
CMD ["--help"]

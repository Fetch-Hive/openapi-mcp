# mcp-gateway config.toml  — schema version
schema_version = 1

# WARNING: never commit tokens, passwords, or private keys to this file.
# Use env references or file references. `mcp-gateway doctor` fails if it
# finds a value that looks like a live token (fh_mcp_, sk_live, Bearer ).

[server]
bind = "127.0.0.1:8787"
path = "/mcp"
expose = false
allow_anonymous = false
token = { env = "MCP_GATEWAY_TOKEN" }

[ssrf]
allow_private_networks = false
allow_insecure_http = false

[cache]
dir = ""
ttl = "168h"

[log]
file = ""
# Default "info". `serve --tunnel` and `tunnel` draw a status screen unless
# you pass --json or --quiet. That screen uses warn,rmcp=off when RUST_LOG
# is unset and this value is "info" or empty, so rmcp INFO lines stay off
# the request log. Any other value is used as written. RUST_LOG replaces it.
# Per-call "mcp request" lines are debug.
level = "info"

# [tunnel]
# relay_url = "wss://connect.mcp.fetchhive.com/v1/tunnel"  # optional; $MCP_GATEWAY_RELAY_URL wins


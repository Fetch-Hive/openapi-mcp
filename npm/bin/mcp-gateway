#!/usr/bin/env node
"use strict";
// No postinstall. Resolve a platform optionalDependency binary.
const { spawnSync } = require("node:child_process");
const { existsSync } = require("node:fs");
const { join } = require("node:path");

const plat = `${process.platform}-${process.arch}`;
const map = {
  "linux-x64": "@fetch-hive/mcp-gateway-linux-x64-musl",
  "linux-arm64": "@fetch-hive/mcp-gateway-linux-arm64-musl",
  "darwin-x64": "@fetch-hive/mcp-gateway-darwin-x64",
  "darwin-arm64": "@fetch-hive/mcp-gateway-darwin-arm64",
  "win32-x64": "@fetch-hive/mcp-gateway-win32-x64-msvc",
};
const pkg = map[plat];
if (!pkg) {
  console.error(`mcp-gateway: no binary for ${plat}`);
  process.exit(1);
}
const binName = process.platform === "win32" ? "mcp-gateway.exe" : "mcp-gateway";
let bin;
try {
  bin = require.resolve(`${pkg}/${binName}`);
} catch {
  bin = join(__dirname, "..", "node_modules", pkg, binName);
}
if (!existsSync(bin)) {
  console.error(`mcp-gateway: missing ${pkg}. Install with npm (optionalDependencies, no lifecycle scripts).`);
  process.exit(1);
}
const result = spawnSync(bin, process.argv.slice(2), { stdio: "inherit" });
process.exit(result.status ?? 1);

{
  "name": "@fetch-hive/mcp-gateway",
  "version": "0.11.4",
  "description": "Turn an OpenAPI spec or a local API into an MCP server, with an optional public HTTPS tunnel",
  "license": "Apache-2.0",
  "mcpName": "io.github.Fetch-Hive/mcp-gateway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fetch-Hive/openapi-mcp.git"
  },
  "bin": {
    "mcp-gateway": "bin/mcp-gateway"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "optionalDependencies": {
    "@fetch-hive/mcp-gateway-linux-x64-musl": "0.11.4",
    "@fetch-hive/mcp-gateway-linux-arm64-musl": "0.11.4",
    "@fetch-hive/mcp-gateway-darwin-x64": "0.11.4",
    "@fetch-hive/mcp-gateway-darwin-arm64": "0.11.4",
    "@fetch-hive/mcp-gateway-win32-x64-msvc": "0.11.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "README.md"
  ]
}
